		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"openapi-typescript": "^7.13.0",
		"playwright": "^1.61.1",
		"shadcn": "^4.21.1",
